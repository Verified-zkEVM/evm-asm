# conformance/candidates.env — pinned, pre-validated real mainnet data for the
# demo acts. Sourced by run.sh. Block-env (Act 1) is fetched LIVE each run;
# these immutable references make Acts 2/3 reproducible and rate-limit-proof.
#
# Re-validate after changing the pinned guest commit:
#   conformance/run.sh --demo --auto

# --- Act 2: real transaction calldata -------------------------------------
# An ERC-20 transfer(address,uint256). Calldata is immutable once mined.
#   selector a9059cbb | recipient (32B) | amount (32B, at calldata offset 0x24)
# Pinned tx amount word = 0x02faf080 = 50,000,000 (a 6-decimals token: 50.0).
ACT2_TX="0xd1cb8d8b6f45c7303e3caa0e0931dd01d23d7d318daab7c49ce5f6ba1129e678"
ACT2_AMOUNT_OFFSET="0x24"

# --- Act 3: real contract bytecode ----------------------------------------
# WETH9 — the canonical wrapped-ETH contract; its 3,124-byte runtime bytecode
# exercises 68 distinct opcodes. Used to (a) run real on-chain bytecode through
# the evm-asm guest and (b) score opcode coverage against the kernel-proven set.
ACT3_CONTRACT="0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2"
ACT3_NAME="WETH9"

# Extra contracts sampled by `--report` (coverage only; space-separated addrs).
REPORT_CONTRACTS="0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2 0x6B175474E89094C44Da98b954EedeAC495271d0F 0xdAC17F958D2ee523a2206206994597C13D831ec7"
