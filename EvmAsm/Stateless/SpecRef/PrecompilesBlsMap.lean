/-! ## sgn0 (hash-to-curve draft §4.1) -/

def sgn0FQ (x : Nat) : Nat := x % 2

def sgn0FQ2 (x : FQP) : Nat := Id.run do
  let mut sign := 0
  let mut zero := 1
  for xi in [x.getD 0 0, x.getD 1 0] do
    let sign_i := xi % 2
    let zero_i := if xi == 0 then 1 else 0
    sign := if sign == 1 then 1 else (if zero == 1 then sign_i else 0)
    zero := zero * zero_i
  pure sign

/-! ## Square-root divisions -/

/-- `sqrt_division_FQ(u, v)`. -/
def sqrt_division_FQ (u v : Nat) : Bool × Nat :=
  let temp := F1.mul u v
  let result := F1.mul temp (EvmAsm.Rv64.Accel.powMod
    (F1.mul temp (F1.mul v v)) P_MINUS_3_DIV_4 blsP)
  (F1.beq (F1.sub (F1.mul (F1.mul result result) v) u) F1.zero, result)

/-- `sqrt_division_FQ2(u, v)` — the exponent is ~761 bits, fueled
    accordingly by `fqpPow`. -/
def sqrt_division_FQ2 (u v : FQP) : Bool × FQP := Id.run do
  let v7 := List.foldl (fun acc _ => F2.mul acc v) v (List.range 6)
  let temp1 := F2.mul u v7
  let temp2 := F2.mul temp1 (F2.mul v7 v)
  let gamma := F2.mul (fqpPow blsP 2 fq2MC temp2 P_MINUS_9_DIV_16) temp1
  let mut is_valid := false
  let mut result := gamma
  for root in POSITIVE_EIGHTH_ROOTS_OF_UNITY do
    let cand := F2.mul root gamma
    if F2.beq (F2.sub (F2.mul (F2.mul cand cand) v) u) F2.zero && !is_valid then
      is_valid := true
      result := cand
  pure (is_valid, result)

/-! ## SWU maps -/

/-- `optimized_swu_G1(t)`. -/
def optimized_swu_G1 (t : Nat) : Proj Nat := Id.run do
  let t2 := F1.mul t t
  let zt2 := F1.mul ISO_11_Z t2
  let temp := F1.add zt2 (F1.mul zt2 zt2)
  let mut denominator := F1.sub F1.zero (F1.mul ISO_11_A temp)
  let temp := F1.add temp F1.one
  let mut numerator := F1.mul ISO_11_B temp
  if F1.beq denominator F1.zero then
    denominator := F1.mul ISO_11_Z ISO_11_A
  let v := F1.mul (F1.mul denominator denominator) denominator
  let u := F1.add (F1.add (F1.mul (F1.mul numerator numerator) numerator)
    (F1.mul (F1.mul ISO_11_A numerator) (F1.mul denominator denominator)))
    (F1.mul ISO_11_B v)
  let (is_root, y0) := sqrt_division_FQ u v
  let mut y := y0
  if !is_root then
    y := F1.mul (F1.mul y (F1.mul (F1.mul t t) t)) SQRT_MINUS_11_CUBED
    numerator := F1.mul numerator zt2
  if sgn0FQ t ≠ sgn0FQ y then
    y := F1.sub F1.zero y
  y := F1.mul y denominator
  pure (numerator, y, denominator)

/-- `optimized_swu_G2(t)`. -/
def optimized_swu_G2 (t : FQP) : Proj FQP := Id.run do
  let t2 := F2.mul t t
  let zt2 := F2.mul ISO_3_Z t2
  let temp := F2.add zt2 (F2.mul zt2 zt2)
  let mut denominator := F2.sub F2.zero (F2.mul ISO_3_A temp)
  let temp := F2.add temp F2.one
  let mut numerator := F2.mul ISO_3_B temp
  if F2.beq denominator F2.zero then
    denominator := F2.mul ISO_3_Z ISO_3_A
  let v := F2.mul (F2.mul denominator denominator) denominator
  let u := F2.add (F2.add (F2.mul (F2.mul numerator numerator) numerator)
    (F2.mul (F2.mul ISO_3_A numerator) (F2.mul denominator denominator)))
    (F2.mul ISO_3_B v)
  let (success, sqrt_candidate0) := sqrt_division_FQ2 u v
  let mut y := sqrt_candidate0
  let sqrt_candidate := F2.mul sqrt_candidate0 (F2.mul (F2.mul t t) t)
  let u1 := F2.mul (F2.mul (F2.mul zt2 zt2) zt2) u
  let mut success_2 := false
  for eta in ETAS do
    let cand := F2.mul eta sqrt_candidate
    let temp1 := F2.sub (F2.mul (F2.mul cand cand) v) u1
    if F2.beq temp1 F2.zero && !success && !success_2 then
      y := cand
      success_2 := true
  -- `not success and not success_2` is unreachable per the reference.
  if !success then
    numerator := F2.mul numerator zt2
  if sgn0FQ2 t ≠ sgn0FQ2 y then
    y := F2.sub F2.zero y
  y := F2.mul y denominator
  pure (numerator, y, denominator)

/-! ## Isogeny maps (Horner evaluation) -/

/-- `iso_map_G1(x, y, z)` (11-isogeny). -/
def iso_map_G1 (x y z : Nat) : Proj Nat := Id.run do
  let z_powers := (List.range 15).map (fun i =>
    (List.range (i + 1)).foldl (fun acc _ => F1.mul acc z) 1)
  let mut mapped : Array Nat := .replicate 4 0
  let mut idx := 0
  for k_i in ISO_11_MAP_COEFFICIENTS do
    let mut v := k_i.getLast? |>.getD 0
    let mut j := 0
    for k_i_j in (k_i.dropLast).reverse do
      v := F1.add (F1.mul v x) (F1.mul (z_powers.getD j 1) k_i_j)
      j := j + 1
    mapped := mapped.set! idx v
    idx := idx + 1
  -- x-denominator polynomial is 1 order lower than the x-numerator's.
  let m1 := F1.mul mapped[1]! z
  let m2 := F1.mul mapped[2]! y
  let m3 := F1.mul mapped[3]! z
  pure (F1.mul mapped[0]! m3, F1.mul m1 m2, F1.mul m1 m3)

/-- `iso_map_G2(x, y, z)` (3-isogeny). -/
def iso_map_G2 (x y z : FQP) : Proj FQP := Id.run do
  let z_powers := (List.range 3).map (fun i =>
    (List.range (i + 1)).foldl (fun acc _ => F2.mul acc z) F2.one)
  let mut mapped : Array FQP := .replicate 4 F2.zero
  let mut idx := 0
  for k_i in ISO_3_MAP_COEFFICIENTS do
    let mut v := k_i.getLast? |>.getD F2.zero
    let mut j := 0
    for k_i_j in (k_i.dropLast).reverse do
      v := F2.add (F2.mul v x) (F2.mul (z_powers.getD j F2.one) k_i_j)
      j := j + 1
    mapped := mapped.set! idx v
    idx := idx + 1
  let m2 := F2.mul mapped[2]! y
  let m3 := F2.mul mapped[3]! z
  pure (F2.mul mapped[0]! m3, F2.mul mapped[1]! m2, F2.mul mapped[1]! m3)

/-- `map_to_curve_G1` + `clear_cofactor_G1`. -/
def map_fp_to_g1 (fp : Nat) : Proj Nat :=
  let (x, y, z) := optimized_swu_G1 fp
  pMul F1 (iso_map_G1 x y z) H_EFF_G1

/-- `map_to_curve_G2` + `clear_cofactor_G2` (`H_EFF_G2` is ~636 bits;
    `pMul`'s 512 fuel is insufficient — use a wider walk). -/
def pMulWide (F : Bn128.FieldOps FQP) (pt : Proj FQP) (n : Nat) : Proj FQP :=
  Bn128.pMulAux F 1024 pt n (F.one, F.one, F.zero)

def map_fp2_to_g2 (t : FQP) : Proj FQP :=
  let (x, y, z) := optimized_swu_G2 t
  pMulWide F2 (iso_map_G2 x y z) H_EFF_G2

end Bls12

namespace GasCosts
def PRECOMPILE_BLS_G1MAP : Uint := 5500
def PRECOMPILE_BLS_G2MAP : Uint := 23800
end GasCosts

/-- `bls12_map_fp_to_g1(evm)` (`bls12_381_g1.py`, function
    `bls12_map_fp_to_g1`). -/
def pBls12MapFpToG1 : EvmM Unit := do
  let data := (← EvmM.getEvm).message.data
  if data.length ≠ 64 then throw (.invalidParameter "Invalid Input Length")
  charge_gas GasCosts.PRECOMPILE_BLS_G1MAP
  let fp := bytesBEtoNat data
  if fp ≥ Bls12.blsP then throw (.invalidParameter "coordinate >= field modulus")
  EvmM.modifyEvm (fun e =>
    { e with output := Bls12.g1_to_bytes (Bls12.map_fp_to_g1 fp) })

/-- `bls12_map_fp2_to_g2(evm)` (`bls12_381_g2.py`, function
    `bls12_map_fp2_to_g2`). -/
def pBls12MapFp2ToG2 : EvmM Unit := do
  let data := (← EvmM.getEvm).message.data
  if data.length ≠ 128 then throw (.invalidParameter "Invalid Input Length")
  charge_gas GasCosts.PRECOMPILE_BLS_G2MAP
  let c0 := bytesBEtoNat (data.take 64)
  let c1 := bytesBEtoNat ((data.drop 64).take 64)
  if c0 ≥ Bls12.blsP || c1 ≥ Bls12.blsP then
    throw (.invalidParameter "coordinate >= field modulus")
  EvmM.modifyEvm (fun e =>
    { e with output := Bls12.g2_to_bytes (Bls12.map_fp2_to_g2 [c0, c1]) })

end EvmAsm.Stateless.SpecRef
