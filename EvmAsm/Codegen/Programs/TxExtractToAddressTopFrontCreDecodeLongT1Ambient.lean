    (hcre : ∀ (next4 len4 : Word),
      rlpItemDecode bs absOff4 (regionBase + BitVec.ofNat 64 absOff4)
        (longWalkEndAmbient regionBase (lenW - (teerTxTypeDispatch (txSlice bs off len)).2.2)
          (ambientAbsOff off (teerTxTypeDispatch (txSlice bs off len)).2.2.toNat)) next4 len4 → len4 = (0 : Word)) :

    cpsTripleWithin
      ((((((((1 + (1 + (1 + 1))) + (1 + 1)) + ((1 + 87) + 1)) +
        (((1 + (1 + 1)) + (1 + 87)) + 1)) +
        (((1 + (1 + 1)) + (1 + 87)) + 1)) +
        (((1 + (1 + 1)) + (1 + 87)) + 1)) +
        (((1 + (1 + 1)) + (1 + 87)) + 1)) +
        (1 + ((1 + (1 + (1 + (1 + (1 + 1))))) + 11)))
      AfterSaveCursor s.ra extractLinkedCode
      (frontAfterSavePostLongAmbient spC s regionBase loadPtr lenW toBuf isCreationPtr bs off len hwi_off)
      (fun h => ∃ next4 : Word,
        ((.x1 ↦ᵣ s.ra) ** (.x2 ↦ᵣ sp0) **
          stackFree sp0 nExtractStackDwords **
          (.x10 ↦ᵣ (0 : Word)) **
          bytesRegion regionBase bs **
          extractToBufOwn toBuf **
          (isCreationPtr ↦ₘ (1 : Word)) **
          (TeaTypeAddr ↦ₘ (1 : Word)) **
          (TeaInnerAddr ↦ₘ (teerTxTypeDispatch (txSlice bs off len)).2.2) **
          (.x8 ↦ᵣ s.s0) ** (.x9 ↦ᵣ s.s1) **
          (.x18 ↦ᵣ s.s2) ** (.x19 ↦ᵣ s.s3) **
          (.x20 ↦ᵣ s.s4) ** (.x21 ↦ᵣ s.s5) ** (.x22 ↦ᵣ s.s6) **
          (Reg.x23 ↦ᵣ s.s7) **
          (.x5 ↦ᵣ (1 : Word)) ** (.x7 ↦ᵣ (0 : Word)) **
          (.x11 ↦ᵣ (0 : Word)) ** (.x12 ↦ᵣ (0 : Word)) **
          (.x0 ↦ᵣ (0 : Word)) **
          regOwn .x13 ** regOwn .x14 ** regOwn .x15 ** regOwn .x16 **
          (.x31 ↦ᵣ (next4 - (0 : Word))) **
          creExtraTemps) h) := by
  let listOff := ambientAbsOff off (teerTxTypeDispatch (txSlice bs off len)).2.2.toNat
  let listLen := lenW - (teerTxTypeDispatch (txSlice bs off len)).2.2
  let cursor := longWalkCursorAmbient regionBase bs listOff hwi_off
  let endPtr := longWalkEndAmbient regionBase listLen listOff
  have hMid := extractT1AfterSaveCreation_then_epi_of_decode_ambient sp0 spC s
    loadPtr regionBase lenW
    (teerTxTypeDispatch (txSlice bs off len)).2.2
    cursor endPtr toBuf isCreationPtr s.s7 bs
    absOff0 absOff1 absOff2 absOff3 absOff4
    hspC hret hcur hsalign
    hoff0 hover0 hvalid0 hss0 hls0 hll0 hdec0 hinb0
    hoff1 hover1 hvalid1 hss1 hls1 hll1 hdec1 hinb1
    hoff2 hover2 hvalid2 hss2 hls2 hll2 hdec2 hinb2
    hoff3 hover3 hvalid3 hss3 hls3 hll3 hdec3 hinb3
    hnext1 hnext2 hnext3
    hoff4 hover4 hvalid4 hss4 hls4 hll4 hdec4 hinb4
    hnext4 hcre
  refine cpsTripleWithin_weaken (fun h hp => ?_) (fun _ hq => hq) hMid
  have hty := frontAfterSavePostLongAmbient_to_midJoinPre spC s regionBase loadPtr
    lenW toBuf isCreationPtr bs off len hwi_off h hp
  simp only [htype1] at hty
  exact hty

#print axioms extractFrontAfterSaveCreation_then_epi_of_decode_long_t1_ambient

