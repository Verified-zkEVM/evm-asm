.lake/
lake-packages/
build/
rust-u256-asm/
gen-out/
.claude/
.codex/
.opencode/
__pycache__/

# jscpd duplication-watch output (scripts/check-duplication.sh)
.jscpd-report/

# Generated progress dashboard (#12683). `scripts/progress-report.sh --write`
# renders it from the kernel-checked registry; it is deliberately NOT committed
# — a generated file in the tree was a standing source of merge conflicts on
# every concurrent PR. The nightly `.github/workflows/progress-history.yml`
# regenerates it into a temp path and snapshots the counts.
PROGRESS.md

# Cockpit snapshot for docs/index.html. Same conflict class as PROGRESS.md:
# regenerate with `scripts/progress-cockpit.sh --write`; CI publishes it to
# GitHub Pages rather than committing the counts.
docs/cockpit/snapshot.json

# ziskemu cycle datapoints appended by scripts/cycles-append.sh (D8; persistence
# to an orphan branch is deferred with the ziskemu live-parse — see the script)
cycles-history.jsonl

# Local/uncommitted per-phase agent hand-off scratch (steering rollout) — never
# committed; only need to exist in the working tree to start the next session.
docs/agents/phase*-bootstrap.md
docs/agents/rollout-complete.md
build.log
log.txt

# OS cruft (macOS Finder / Windows)
.DS_Store
Thumbs.db

# Editor swap / backup files
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# AI agent local scratch dirs (analogous to .claude/ .codex/ .opencode/;
# .opencode/ is added separately in #10379)
.gemini/
.cursor/
.aider*
.continue/
